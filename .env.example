# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=discord_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only Database Role for Agent Safety
POSTGRES_READONLY_USER=discord_readonly
POSTGRES_READONLY_PASSWORD=readonly_secure_password

# LLM API Configuration (Google GenAI / Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Backend Configuration
HOST=0.0.0.0
PORT=8000
ARTIFACTS_DIR=./artifacts
MAX_SQL_ROW_LIMIT=1000
SQL_TIMEOUT_SECONDS=5.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
